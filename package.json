{
  "name": "simple-bottom-panel",
  "version": "1.0.0",
  "description": "A configurable bottom panel for every monitor.",
  "type": "module",
  "private": true,
  "license": "GPL-2.0-or-later",
  "shell-version": [
    "45",
    "46",
    "47",
    "48",
    "49"
  ],
  "uuid": "simple-bottom-panel@local",
  "settings-schema": "org.gnome.shell.extensions.simple-bottom-panel",
  "gettext-domain": "simple-bottom-panel",
  "scripts": {
    "build": "rollup -c",
    "dev": "npm run dev:install",
    "package": "package=1 rollup -c",
    "clean": "rm -rf build dist dist-tests",
    "dev:install": "ZIP=\"build/${npm_package_name}.v${npm_package_version}.shell-extension.zip\" && gnome-extensions install --force \"$ZIP\"",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "code:fix": "npm run lint:fix && npm run format",
    "code:check": "npm run lint && npm run format:check",
    "type:check": "tsc -p jsconfig.tsc.json",
    "test": "npx rollup -c rollup.config.test.js && NODE_OPTIONS=--experimental-vm-modules jasmine --no-color ./dist-tests/tests/*/*/*.test.js",
    "test:integration": "npx rollup -c rollup.config.test.js && NODE_OPTIONS=--experimental-vm-modules jasmine --no-color ./dist-tests/tests/integration/*/*.test.js",
    "test:unit": "npx rollup -c rollup.config.test.js && NODE_OPTIONS=--experimental-vm-modules jasmine --no-color ./dist-tests/tests/unit/*/*.test.js",
    "docs": "jsdoc -c jsdoc.conf.json",
    "docs:serve": "npm run docs && serve docs/",
    "docs:watch": "jsdoc -c jsdoc.conf.json --watch"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@girs/gjs": "latest",
    "@girs/glib-2.0": "latest",
    "@girs/gnome-shell": "latest",
    "@rollup/plugin-alias": "latest",
    "@rollup/plugin-commonjs": "latest",
    "@rollup/plugin-node-resolve": "latest",
    "eslint-config-prettier": "latest",
    "globals": "latest",
    "jsdoc": "latest",
    "prettier": "latest",
    "rollup": "latest",
    "rollup-plugin-copy": "latest",
    "rollup-plugin-delete": "latest",
    "rollup-plugin-scss": "latest",
    "rollup-plugin-zipdir": "latest",
    "sass": "latest",
    "typescript": "latest",
    "eslint": "latest",
    "jasmine": "latest",
    "serve": "latest",
    "fflate": "latest"
  }
}
